local MusicData: {
	Playlist: { MusicItem },
	SoundEffects: any,
	SetExternalSongs: (songs: { MusicItem }) -> (),
} = {
	Playlist = table.clone(OriginalPlaylist),
	SoundEffects = OriginalSoundEffects,
} :: any

function MusicData.SetExternalSongs(songs: { MusicItem })
	table.clear(MusicData.Playlist)
	for _, s in ipairs(OriginalPlaylist) do
		table.insert(MusicData.Playlist, s)
	end
	for _, s in ipairs(songs) do
		table.insert(MusicData.Playlist, s)
	end
end

return MusicData
